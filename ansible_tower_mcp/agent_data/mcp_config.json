{
  "mcpServers": {
    "ansible-tower-mcp": {
      "command": "ansible-tower-mcp",
      "args": [
        "--transport",
        "stdio"
      ],
      "env": {
        "ANSIBLE_TOWER_URL": "${ANSIBLE_TOWER_URL}",
        "ANSIBLE_TOWER_TOKEN": "${ANSIBLE_TOWER_TOKEN}",
        "ANSIBLE_BASE_URL": "${ANSIBLE_BASE_URL}",
        "ANSIBLE_CLIENT_ID": "${ANSIBLE_CLIENT_ID}",
        "ANSIBLE_CLIENT_SECRET": "${ANSIBLE_CLIENT_SECRET}",
        "ANSIBLE_PASSWORD": "${ANSIBLE_PASSWORD}",
        "ANSIBLE_TOKEN": "${ANSIBLE_TOKEN}",
        "ANSIBLE_USERNAME": "${ANSIBLE_USERNAME}",
        "ANSIBLE_VERIFY": "${ANSIBLE_VERIFY}"
      }
    }
  }
}
